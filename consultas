-- =========================================================================
-- 4.3 Compras, Proveedores y Existencias
-- =========================================================================

--RF-COM-02 — Asignar a una compra productos con cantidades y precios
SELECT
compras.id_compra,
compras.id_proveedor,
detalle_compras.id_producto,
detalle_compras.cantidad,
detalle_compras.precio_unitario,
detalle_compras.subtotal
FROM compras
JOIN detalle_compras
ON compras.id_compra = detalle_compras.id_compra;


-- RF-COM-03: El sistema debe permitir editar una compra hecha a un proveedor
UPDATE compras
SET id_proveedor = 6,
    fecha_compra = '2026-09-19 10:00:00',
    total = 7350000.00
WHERE id_compra = 24;


-- RF-COM-04: El sistema debe permitir anular una compra hecha a un proveedor 
UPDATE compras
SET estado = 'anulada'
WHERE id_compra = 24;


-- RF-COM-06: Listar proveedores con su estado
SELECT id_proveedor, nombre, nit, telefono, email, estado
FROM proveedores
ORDER BY estado, nombre;

-- RF-COM-07: Buscar un proveedor por nombre o NIT y consultar su estado
SELECT id_proveedor, nombre, nit, telefono, email, direccion, estado
FROM proveedores
WHERE nombre LIKE CONCAT('%', 'Dislicores', '%')
   OR nit = '890924912-8';
   
-- RF-COM-08: El sistema permite editar el estado de un proveedor
UPDATE compras
SET estado = 'Anulado'
where id_compra = 24;


-- RF-COM-12: Listar las existencias (stock) de todos los productos
SELECT id_producto, nombre, stock_actual, stock_minimo, stock_maximo, estado
FROM productos
ORDER BY nombre;


-- RF-COM-13: Buscar las existencias de un producto por nombre
SELECT id_producto, nombre, stock_actual, stock_minimo, stock_maximo, estado
FROM productos
WHERE nombre LIKE CONCAT('%', 'Ron Medellín', '%');

-- RF-COM-14: El sistema debe permitir editar las existencias de un producto
UPDATE productos
SET stock_actual = 20
WHERE id_producto = 30;


-- RF-COM-15: Cuando el stock de un producto llegue al stock mínimo, 
-- el sistema debe generar una alerta visible en el panel del Administrador.


SELECT id_producto, nombre, stock_actual, stock_minimo
FROM productos
WHERE stock_actual <= stock_minimo
  AND estado = 'inactivo';


