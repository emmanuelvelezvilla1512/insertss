-- =========================================================================
-- 4.8  Medición de Desempeño
-- =========================================================================

--RF-DES-01 — Generar un reporte de Top 10 de clientes VIP
SELECT
clientes.id_cliente,
clientes.primer_nombre,
clientes.primer_apellido,
SUM(ventas.total) AS total_compras
FROM clientes
JOIN ventas
ON clientes.id_cliente = ventas.id_cliente
WHERE clientes.es_vip = 1
GROUP BY
clientes.id_cliente,
clientes.primer_nombre,
clientes.primer_apellido
ORDER BY total_compras DESC
LIMIT 10;


--RF-DES-02 — Generar un reporte de Top 10 de clientes generales


SELECT
clientes.id_cliente,
clientes.primer_nombre,
clientes.primer_apellido,
SUM(ventas.total) AS total_compras
FROM clientes
JOIN ventas
ON clientes.id_cliente = ventas.id_cliente
WHERE clientes.es_vip = 0
GROUP BY
clientes.id_cliente,
clientes.primer_nombre,
clientes.primer_apellido
ORDER BY total_compras DESC
LIMIT 10;


--RF-DES-03 — Mostrar los servicios más solicitados


SELECT
servicios.id_servicio,
servicios.nombre,
SUM(detalle_reserva.cantidad) AS cantidad_solicitada
FROM servicios
JOIN detalle_reserva
ON servicios.id_servicio = detalle_reserva.id_servicio
GROUP BY
servicios.id_servicio,
servicios.nombre
ORDER BY cantidad_solicitada DESC;


--RF-DES-04 — Mostrar los servicios menos solicitados
SELECT
servicios.id_servicio,
servicios.nombre,
SUM(detalle_reserva.cantidad) AS cantidad_solicitada
FROM servicios
JOIN detalle_reserva
ON servicios.id_servicio = detalle_reserva.id_servicio
GROUP BY
servicios.id_servicio,
servicios.nombre
ORDER BY cantidad_solicitada ASC;


--RF-DES-05 — Mostrar el Top 3 de productos menos vendidos


SELECT
productos.id_producto,
productos.nombre,
SUM(detalle_ventas.cantidad) AS cantidad_vendida
FROM productos
JOIN detalle_ventas
ON productos.id_producto = detalle_ventas.id_producto
GROUP BY
productos.id_producto,
productos.nombre
ORDER BY cantidad_vendida ASC
LIMIT 3;


--RF-DES-06 — Generar reportes de ventas mes a mes
SELECT
YEAR(fecha_venta) AS año,
MONTH(fecha_venta) AS mes,
SUM(total) AS total_ventas
FROM ventas
WHERE estado = 'pagada'
GROUP BY
YEAR(fecha_venta),
MONTH(fecha_venta)
ORDER BY
año,
mes;


--RF-DES-07 — Mostrar el día de mayor venta
SELECT
DATE(fecha_venta) AS fecha,
SUM(total) AS total_ventas
FROM ventas
WHERE estado = 'pagada'
GROUP BY DATE(fecha_venta)
ORDER BY total_ventas DESC
LIMIT 1;


--RF-DES-08 — Mostrar el mes de mayor venta
SELECT
YEAR(fecha_venta) AS año,
MONTH(fecha_venta) AS mes,
SUM(total) AS total_ventas
FROM ventas
WHERE estado = 'pagada'
GROUP BY
YEAR(fecha_venta),
MONTH(fecha_venta)
ORDER BY total_ventas DESC
LIMIT 1;

--RF-DES-09 — Mostrar los subtotales de ventas mensuales

SELECT
YEAR(ventas.fecha_venta) AS año,
MONTH(ventas.fecha_venta) AS mes,
SUM(detalle_ventas.subtotal) AS subtotal_mensual
FROM ventas
JOIN detalle_ventas
ON ventas.id_venta = detalle_ventas.id_venta
WHERE ventas.estado = 'pagada'
GROUP BY
YEAR(ventas.fecha_venta),
MONTH(ventas.fecha_venta)
ORDER BY
año,
mes;