SELECT
reservas.id_reserva,
clientes.primer_nombre,
clientes.primer_apellido,
reservas.tipo_espacio,
reservas.fecha,
reservas.hora,
reservas.estado
FROM reservas
JOIN clientes
ON reservas.id_cliente = clientes.id_cliente;

--RF-SER-09 — Consultar el estado de una reserva
SELECT
id_reserva,
id_cliente,
tipo_espacio,
fecha,
hora,
estado
FROM reservas;

--RF-SER-10 — Actualizar el estado de una reserva
