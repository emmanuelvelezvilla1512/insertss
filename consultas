-- 4.1 Configuración: Roles y Permisos
-- =========================================================================

--RF-ROL-01 — Crear un rol con nombre único

SELECT
id_rol,
nombre_rol,
descripcion,
estado
FROM roles;


--RF-ROL-02 — Asignar permisos específicos a un rol
SELECT
roles.nombre_rol,
permisos.nombre_permiso,
permisos.descripcion
FROM rol_permiso
JOIN roles
ON rol_permiso.roles_id_rol = roles.id_rol
JOIN permisos
ON rol_permiso.permisos_id_permisos = permisos.id_permiso;


--RF-ROL-03 — Buscar permisos asociados a un rol
SELECT
roles.nombre_rol,
permisos.nombre_permiso,
permisos.descripcion
FROM rol_permiso
JOIN roles
ON rol_permiso.roles_id_rol = roles.id_rol
JOIN permisos
ON rol_permiso.permisos_id_permisos = permisos.id_permiso
WHERE roles.id_rol = 1;


--RF-ROL-03 — Editar los permisos asociados a un rol
UPDATE permisos
SET nombre_permiso = 'editar_usuario',
descripcion = 'Permite modificar la información de los usuarios'
WHERE id_permiso = 2;


--RF-ROL-04 — Cambiar el estado de los permisos asociados a un rol
UPDATE permisos
SET estado = 'inactivo'
WHERE id_permiso = 20;


--RF-ROL-05 — Eliminar los permisos asociados a un rol


SELECT
roles.nombre_rol,
permisos.nombre_permiso
FROM rol_permiso
JOIN roles
ON rol_permiso.roles_id_rol = roles.id_rol
JOIN permisos
ON rol_permiso.permisos_id_permisos = permisos.id_permiso
WHERE roles.id_rol = 1;


--RF-ROL-06 — Listar los permisos asociados a un rol
SELECT
roles.nombre_rol,
permisos.nombre_permiso,
permisos.descripcion,
permisos.estado
FROM rol_permiso
JOIN roles
ON rol_permiso.roles_id_rol = roles.id_rol
JOIN permisos
ON rol_permiso.permisos_id_permisos = permisos.id_permiso
WHERE roles.id_rol = 1;




