-- 4.5 Servicios, Empleados y Reservas
-- =========================================================================

--RF-SER-02 — Consultar el estado de los servicios
SELECT
id_servicio,
nombre,
precio,
estado
FROM servicios;

--RF-SER-03 — Actualizar el estado de los servicios
UPDATE servicios
SET estado = 'inactivo'
WHERE id_servicio = 6;

--RF-SER-04 — Cambiar el estado de los servicios
UPDATE servicios
SET estado = 'activo'
WHERE id_servicio = 6;

--RF-SER-05 — Consultar categorías de empleados y sus empleados
SELECT
categoria_empleado.id_categoria_empleado,
categoria_empleado.nombre AS categoria,
empleados.id_empleado,
empleados.primer_nombre,
empleados.primer_apellido
FROM categoria_empleado
JOIN empleados
ON categoria_empleado.id_categoria_empleado = empleados.id_categoria_empleado;

--RF-SER-06 — Consultar empleados asociados a una categoría
SELECT
empleados.id_empleado,
empleados.primer_nombre,
empleados.primer_apellido,
categoria_empleado.nombre AS categoria
FROM empleados
JOIN categoria_empleado
ON empleados.id_categoria_empleado = categoria_empleado.id_categoria_empleado
WHERE categoria_empleado.id_categoria_empleado = 2;

--RF-SER-07 — Consultar la agenda de un empleado asociada a servicio o evento
SELECT
agenda_empleado.id_agenda_empleado,
empleados.primer_nombre,
empleados.primer_apellido,
servicios.nombre AS servicio,
evento.nombre AS evento,
agenda_empleado.fecha,
agenda_empleado.hora_inicio,
agenda_empleado.hora_fin,
agenda_empleado.estado
FROM agenda_empleado
JOIN empleados
ON agenda_empleado.id_empleados = empleados.id_empleado
LEFT JOIN servicios
ON agenda_empleado.id_servicios = servicios.id_servicio
LEFT JOIN evento
ON agenda_empleado.id_evento = evento.id_evento;

